# Frontend Vite env example
# Copy to .env for local dev. NEVER commit .env — Vite bakes it into the build,
# which is how localhost:3001 once leaked into production.
#
# In deploys, VITE_API_URL is optional: when unset, src/apis/env.ts picks the
# backend by hostname (alertup.world -> prod backend, stage/pre-prod.alertup.world
# -> stage backend). Set it in Vercel only to override.

# Local dev (backend running locally; local backend uses the STAGE database):
VITE_API_URL=http://localhost:3001

# stage / pre-prod override: https://alertup-backend-stage.onrender.com
# production override:       https://alertup-backend.onrender.com
